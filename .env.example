# Environment variables for FinAtlas. Never commit real values; set them in the Secrets panel / host env.

# Google Gemini API key (fallback name: AI_API_KEY)
GOOGLE_API_KEY=
# Optional Gemini model name (default gemini-2.0-flash)
GEMINI_MODEL=
# Supabase project URL
SUPABASE_URL=
# Supabase anon key
SUPABASE_ANON_KEY=
